# Copy to .env and adjust
APP_NAME=Smart Agriculture Platform
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite for local dev (default). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smartfarm
DATABASE_URL=sqlite:///./smartfarm.db

# Comma-separated origins allowed to call the API (frontend hosts)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
